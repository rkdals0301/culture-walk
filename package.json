{
  "name": "culture-walk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply culture-walk-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply culture-walk-db --remote",
    "db:seed:local": "node scripts/seed-local-sample.mjs",
    "db:seed:local:from-production": "node scripts/seed-local-sample.mjs --from-production --reset-local",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:run": "node scripts/prepare-e2e.mjs && playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tanstack/react-virtual": "^3.10.8",
    "axios": "^1.18.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^11.9.0",
    "lucide-react": "^1.26.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-loading-skeleton": "^3.5.0",
    "react-spinners": "^0.17.0",
    "react-toastify": "^10.0.5",
    "sass": "^1.79.4",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@playwright/test": "^1.63.0",
    "@svgr/webpack": "^8.1.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8.5.26",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4",
    "next": {
      "postcss": "^8.5.26"
    }
  }
}
