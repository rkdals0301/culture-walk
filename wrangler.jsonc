{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "culture-walk",
  "main": "worker.js",
  "compatibility_date": "2026-03-30",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["10 19,20 * * *", "2,7,12,17,22,27,32,37,42,47,52,57 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_BASE_URL": "https://culturewalk.gangmin.dev",
    "SITE_URL": "https://culturewalk.gangmin.dev",
    "TOUR_API_BASE_URL": "https://apis.data.go.kr/B551011/KorService2"
  },
  "kv_namespaces": [
    {
      "binding": "CULTURE_CACHE",
      "id": "5a421575aa4b4466bc15c461152e2b04",
      "preview_id": "f6a1c4e81a104f8aaeb83e4097d6b1bb"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "culture-walk-db",
      "database_id": "eeb25c40-46ce-46ff-8b13-46ea719ea6a6",
      // Local development intentionally reads the production D1 database.
      "remote": true,
      "migrations_dir": "db/migrations"
    }
  ]
}
